# Bliss Environment Template
# Copy to .env and fill values for your environment.

# -----------------------------
# App / Network
# -----------------------------
NEXT_PUBLIC_APP_NAME=Bliss
NEXT_PUBLIC_APP_URL=http://localhost:9002
NEXT_PUBLIC_ALEO_NETWORK=testnet
NEXT_PUBLIC_ALEO_API_URL=https://api.explorer.provable.com/v2
NEXT_PUBLIC_ALEO_FEE_MICROCREDITS=1000000

# -----------------------------
# Deployed Program IDs (Aleo testnet)
# -----------------------------
NEXT_PUBLIC_AGE_VERIFICATION_PROGRAM=bliss_age_verification_v4.aleo
NEXT_PUBLIC_PROFILE_VERIFICATION_PROGRAM=bliss_profile_verification_v4.aleo
NEXT_PUBLIC_COMPATIBILITY_MATCHING_PROGRAM=bliss_compatibility_matching_v2.aleo
NEXT_PUBLIC_SUBSCRIPTION_ACCESS_PROGRAM=bliss_subscription_access_v2.aleo

# Optional: deployment tx references (for UI/docs)
NEXT_PUBLIC_AGE_VERIFICATION_DEPLOY_TX=at1y64dx63ssptlnup0qphk8ygaqhp0xt24ds8c6fq5mfxdnt4p7vgqjrv6ca
NEXT_PUBLIC_PROFILE_VERIFICATION_DEPLOY_TX=at16s46n7z4g6a7vt9ttmlwu9eapw60j2r8zhd24850lav64326nqzsys8lna
NEXT_PUBLIC_COMPATIBILITY_MATCHING_DEPLOY_TX=at1y3kays34gprdnhlqgvts4qgphwaf3t7eg4hj5l8em7wje9h0qqrq5wnuex
NEXT_PUBLIC_SUBSCRIPTION_ACCESS_DEPLOY_TX=at1hzndqn298fuslk7nvll7z79p5v6avtjagaxgrx9dxrspqzymlgzsylgray

# -----------------------------
# Subscription Payments
# -----------------------------
NEXT_PUBLIC_BLISS_TREASURY_ADDRESS=aleo1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------
# Storage / Media
# -----------------------------
PINATA_JWT=your_pinata_jwt_here
NEXT_PUBLIC_PINATA_GATEWAY=your-gateway-id.mypinata.cloud

# -----------------------------
# Optional deployment-only vars (used by Leo scripts)
# -----------------------------
NETWORK=testnet
ENDPOINT=https://api.explorer.provable.com/v2
# PRIVATE_KEY=APrivateKey1...
# ALEO_PRIVATE_KEY=APrivateKey1...

# -----------------------------
# Feature flags / limits
# -----------------------------
NEXT_PUBLIC_MAX_SWIPES_FREE_TIER=10
NEXT_PUBLIC_MAX_CHATS_FREE_TIER=3
NEXT_PUBLIC_DEFAULT_GEOHASH_PRECISION=5
NEXT_PUBLIC_DEBUG_MODE=false
NEXT_PUBLIC_MOCK_WALLET_SIGNATURES=false
NEXT_PUBLIC_PROFILE_ALLOW_LEGACY_AGE_BOOL=false
NEXT_PUBLIC_SWIPE_SETTLEMENT_MODE=deferred
NEXT_PUBLIC_SWIPE_SETTLEMENT_THRESHOLD=5
NEXT_PUBLIC_BACKGROUND_SETTLEMENT_INTERVAL_MS=45000
NEXT_PUBLIC_BACKGROUND_SETTLEMENT_IDLE_MS=20000
NEXT_PUBLIC_BACKGROUND_SETTLEMENT_STALE_MS=300000
NEXT_PUBLIC_BACKGROUND_SETTLEMENT_COOLDOWN_MS=90000

NODE_ENV=development
